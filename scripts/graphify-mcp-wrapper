#!/usr/bin/env bash
set -euo pipefail

root=${1:-$PWD}
if [[ ! -d "$root" ]]; then
  printf 'graphify: project root is not a directory: %s\n' "$root" >&2
  exit 2
fi
root=$(cd "$root" && pwd -P)
out="$root/.opencode/graphify-out"
graph="$out/graph.json"
export GRAPHIFY_OUT="$out"

if [[ ! -s "$graph" ]]; then
  graphify extract "$root" --code-only --no-cluster --out "$root" >&2
else
  graphify update "$root" --no-cluster >&2
fi

exec graphify-mcp "$graph"
